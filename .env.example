# ==============================================================================
# SettleX Environment Variables (Template / Example Only)
# ==============================================================================
# DO NOT add real private keys, mnemonics, or production secrets to this file.
# Copy this file to `.env` and fill in your values locally:
#   cp .env.example .env
# Ensure `.env` is never committed to version control.
# ==============================================================================

# Monad Testnet Network Configuration
MONAD_RPC_URL="https://testnet-rpc.monad.xyz"
MONAD_CHAIN_ID=10143

# Deployment Account Configuration (Monad Testnet Development Only)
# Option A: Plaintext private key (recommended only for ephemeral testnet addresses)
# Format: 64-character hex string (with or without 0x prefix)
DEPLOYER_PRIVATE_KEY=""

# Option B (Recommended): Use Foundry cast keystore instead of DEPLOYER_PRIVATE_KEY
# Import your account once securely:
#   cast wallet import settlex-deployer --interactive
# Then deploy using:
#   forge script contracts/script/DeploySettleXEscrow.s.sol --account settlex-deployer

# Block Explorer Verification API Key (Optional)
MONAD_EXPLORER_API_KEY=""
